# Python-generated files
__pycache__/
*.py[oc]
*.pyd
build/
dist/
wheels/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
*.manifest
*.spec

# Testing / linting / type-checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Editors / IDE
.vscode/
.idea/

# Generated data: keep the folder (via .gitkeep), ignore what the notebooks write into it
data/processed/*
!data/processed/.gitkeep

# Local vector stores at the project root (chroma_db/, faiss_index/, ...): rebuilt by the notebooks
vectorstore/*
!vectorstore/.gitkeep
*.sqlite3
*.faiss
*.index
chroma.sqlite3
.chroma/

# Model / embedding caches
.cache/
models/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
