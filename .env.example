# Copy to .env (gitignored) and fill in the keys for the notebooks you run.
# src/config.py loads .env from the project root, so it is picked up from any folder.

# LLMs and embeddings (src/llm_factory.py)
OPENAI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# LangSmith tracing and evaluation (05_eval_and_observability)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-bootcamp

# PostgreSQL (07_database_parsing)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Chroma Cloud (01.1.chroma_cloud)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# DataStax Astra DB (05_datastax_astra)
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=

# Pinecone (06_pinecone)
PINECONE_API_KEY=

# Milvus on Zilliz Cloud (07_milvus): the cluster Public Endpoint (https://...) and an API key or username:password
MILVUS_CLOUD_URI=
MILVUS_CLOUD_TOKEN=
